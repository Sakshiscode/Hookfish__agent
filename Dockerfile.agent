FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libffi-dev && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY voice_agent.py .
COPY db_helper.py .
COPY google_calendar.py .
COPY whatsapp_helper.py .
COPY batch_call.py .
COPY batch_call_trigger.py .
COPY batch_call_campaign.py .

RUN echo '#!/bin/sh\necho $GOOGLE_CREDENTIALS_JSON | base64 -d > /app/google_credentials.json 2>/dev/null || true\nexec python voice_agent.py start' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

CMD ["/app/entrypoint.sh"]