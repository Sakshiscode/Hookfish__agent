# LiveKit Connection
LIVEKIT_URL=wss://your-host.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# LLM Providers
AZURE_OPENAI_API_KEY=your_azure_key
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
GROQ_API_KEY=your_groq_key
CEREBRAS_API_KEY=your_cerebras_key
TOGETHER_API_KEY=your_together_key

# Speech Services (TTS/STT)
deepgram_API_KEY=your_deepgram_key
SMALLEST_API_KEY=your_smallest_ai_key
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=centralindia
ELEVEN_API_KEY=your_elevenlabs_key
cartesia_API_KEY=your_cartesia_key
sarvam_API_KEY=your_sarvam_key

# Database (MySQL/Aiven)
DB_HOST=your-db-host
DB_PORT=14064
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_db_password

# Telephony (Vobiz)
VOBIZ_USERNAME=your_username
VOBIZ_PASSWORD=your_password
VOBIZ_SIP_DOMAIN=your.sip.domain
TRUNK_ID=your_trunk_id

# Google Calendar Integration
GOOGLE_CALENDAR_CREDENTIALS_FILE=google_credentials.json
GOOGLE_CALENDAR_ID=your_email@gmail.com
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
GOOGLE_CALENDAR_DEFAULT_DURATION=60

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_BUSINESS_NAME=Hookfish
